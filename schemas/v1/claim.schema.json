{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmacrostate.org/schemas/v1/claim.schema.json",
  "title": "OpenMacroState Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "statement",
    "claim_type",
    "as_of",
    "information_cutoff",
    "evidence_ids",
    "limitations",
    "falsifiers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_id": {"$ref": "#/$defs/stableId"},
    "statement": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["fact", "inference", "assumption", "unknown"]},
    "as_of": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "evidence_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "status": {"enum": ["candidate", "supported", "weakened", "invalidated", "unknown"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "observable"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "observable": {"type": "string", "minLength": 1},
          "window": {"type": ["string", "null"]}
        }
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,255}$"
    }
  }
}
