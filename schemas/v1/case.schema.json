{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmacrostate.org/schemas/v1/case.schema.json",
  "title": "OpenMacroState Case Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "description",
    "information_cutoff",
    "fixture_kind",
    "artifacts_file",
    "observations_file",
    "claims_file",
    "predictions_file"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "fixture_kind": {"enum": ["synthetic", "licensed_public", "restricted_reference"]},
    "artifacts_file": {"type": "string", "minLength": 1},
    "observations_file": {"type": "string", "minLength": 1},
    "claims_file": {"type": "string", "minLength": 1},
    "predictions_file": {"type": "string", "minLength": 1},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
